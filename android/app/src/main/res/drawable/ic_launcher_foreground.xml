<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo NOVA CORE : noyau lumineux, anneau et deux orbites inclinées.
  Dessiné en vectoriel pour rester net à toutes les densités.
  Zone de sécurité de l'icône adaptative : 66 dp centrés sur 108.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Anneau intérieur -->
    <path
        android:pathData="M31,54 a23,23 0 1,0 46,0 a23,23 0 1,0 -46,0"
        android:strokeColor="#3B73FF"
        android:strokeWidth="2"
        android:strokeAlpha="0.75" />

    <!-- Orbite inclinée vers la gauche -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-24">
        <path
            android:pathData="M23,54 a31,12 0 1,0 62,0 a31,12 0 1,0 -62,0"
            android:strokeColor="#35E0FF"
            android:strokeWidth="2.6" />
    </group>

    <!-- Orbite inclinée vers la droite -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="38">
        <path
            android:pathData="M23,54 a31,12 0 1,0 62,0 a31,12 0 1,0 -62,0"
            android:strokeColor="#A855F7"
            android:strokeWidth="2.6"
            android:strokeAlpha="0.85" />
    </group>

    <!-- Halo du noyau -->
    <path
        android:pathData="M39,54 a15,15 0 1,0 30,0 a15,15 0 1,0 -30,0"
        android:fillColor="#35E0FF"
        android:fillAlpha="0.22" />

    <!-- Noyau -->
    <path
        android:pathData="M44,54 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0"
        android:fillColor="#BFF4FF" />
</vector>
