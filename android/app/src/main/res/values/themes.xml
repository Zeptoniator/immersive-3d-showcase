<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NovaCore" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/void_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/cyan</item>
    </style>

    <!-- Écran de démarrage : logo NOVA CORE sur le fond du site, sans à-coup
         visuel entre le lancement et l'affichage de la page. -->
    <style name="Theme.NovaCore.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/void_deep</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.NovaCore</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
    </style>
</resources>
