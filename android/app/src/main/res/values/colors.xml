<?xml version="1.0" encoding="utf-8"?>
<!--
  Palette du thème clair, reprise de src/styles/tokens.css côté site.

  C'est le jeu par défaut : le thème `DayNight` bascule automatiquement sur
  values-night/ quand le système est en mode sombre. L'habillage natif suit donc
  la même préférence que la page affichée dans la WebView.
-->
<resources>
    <color name="surface">#EEF2F9</color>
    <color name="surface_raised">#FFFFFF</color>
    <color name="accent">#0B6B86</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="text">#0A1022</color>
    <color name="text_muted">#3F4C68</color>

    <!-- Logo de l'écran de démarrage : lisible sur fond clair. -->
    <color name="logo_ring">#2A54C8</color>
    <color name="logo_orbit_cool">#0B6B86</color>
    <color name="logo_orbit_warm">#7C3AED</color>
    <color name="logo_core">#0B6B86</color>
    <color name="logo_halo">#0B6B86</color>
</resources>
